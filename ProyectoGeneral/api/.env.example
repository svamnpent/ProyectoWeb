# Copia este archivo a ".env" (que NO se versiona) y ajusta los valores.

# --- Base de datos (PostgreSQL en Docker) ---
POSTGRES_DB=phantom_db
DB_USERNAME=phantom
DB_PASSWORD=cambia-esta-password
DB_PORT=5432

# --- Seguridad ---
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32+-caracteres
JWT_EXPIRATION_MINUTES=60

# Administrador inicial (se crea al arrancar si no existe). Contraseña de al menos 8 caracteres.
ADMIN_EMAIL=admin@phantom.local
ADMIN_PASSWORD=cambia-esta-password-admin

# --- Otros ---
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# "demo" carga datos FALSOS de prueba (usuarios con clave Demo12345). Quítalo en producción.
SPRING_PROFILES_ACTIVE=demo
